--Script to spawn the islands into the game

--Services
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

--Variables
local islandData = require(game.ReplicatedStorage.ModuleScripts.islandData)
local islandFolder = game.ServerStorage.Islands
local enemyFolder = game.ServerStorage.Enemies
local cooldown = false
local islandList = {}

local skeleton = require(game.ServerStorage.Npcs.Skeleton)
local range = require(game.ServerStorage.Npcs.Range)



local difficultyData = require(game.ReplicatedStorage.ModuleScripts.difficultyData)
local difficultyChoice = difficultyData.getDifficulty()
local difficulty = difficultyData[difficultyChoice]
if difficulty == nil then
	difficultyChoice = "easy"
	warn("Difficulty not found, defaulting to easy")
	difficulty = difficultyData[difficultyChoice]
end

local meterCount = 0


--Functions

local function chooseItem(itemPool)
	local itemType
	
	if itemPool == "ValuableResource" then
		itemType = itemPool
	elseif itemPool == "allValuablePool" then
		itemType = itemPool
	elseif itemPool == "Valuable" then
		itemType = itemPool
	else
		local itemTypeNumb = math.random(1, #difficulty.LootPool)
		itemType = difficulty.LootPool[itemTypeNumb]
	end
	itemType = difficultyData.getCorrespondingList(itemType)
	local item = itemType[math.random(1, #itemType)]
	return item
end

local function spawnOutpost()
	local outpostFolder = game.ServerStorage.Outpost
	local outPostArray = outpostFolder:GetChildren()
	local choice = outPostArray[math.random(1, #outPostArray)]
	local xPosition = meterCount + 10000
	local zPosition = math.random(-200,600)
	local sellIslandClone = choice:Clone()
	sellIslandClone.Name = "sellIsland".. (meterCount)
	sellIslandClone.Parent = workspace.scriptFolders.Islands
	local targetCFrame = CFrame.new(xPosition, -13, zPosition)
	sellIslandClone:PivotTo(targetCFrame)
	sellIslandClone:PivotTo(CFrame.new(sellIslandClone:GetPivot().Position) * CFrame.Angles(0, math.rad(math.random(0, 360)), 0))
end

local function spawnBanditCamp()
	local banditCampFolder = game.ServerStorage.BanditCamps
	local banditCampArray = banditCampFolder:GetChildren()
	
	
	local choice = banditCampArray[math.random(1, #banditCampArray)]
	
	local xPosition = math.random(6500, 8000) + meterCount
	local zPosition = math.random(-200, 600)
	local banditCampClone = choice:Clone()
	banditCampClone.Name = "banditCamp".. (meterCount)
	banditCampClone.Parent = workspace.scriptFolders.Islands
	local targetCFrame = CFrame.new(xPosition, -13, zPosition)
	banditCampClone:PivotTo(targetCFrame)
	banditCampClone:PivotTo(CFrame.new(banditCampClone:GetPivot().Position) * CFrame.Angles(0, math.rad(math.random(0, 360)), 0))
	
	local enemySpawnSpots = banditCampClone:FindFirstChild("spawnSpots"):FindFirstChild("enemySpawners")
	local enemySpawnSpotsArray = enemySpawnSpots:GetChildren()
	local numberOfEnemies
	local numberOfItems = math.random(8, 12)
	if banditCampClone:HasTag("BigCamp") then
		numberOfEnemies = 40
		math.round(numberOfItems * 1.8)
	else 
		numberOfEnemies = 20
	end
	for i = 1, numberOfEnemies do
		local spot
		local spotChoice
		repeat
			spotChoice = math.random(1, #enemySpawnSpots:GetChildren())
			spot = enemySpawnSpotsArray[spotChoice]
		until spot ~= nil
		enemySpawnSpotsArray[spotChoice] = nil
		local enemy = "Bandit"
		local specificEnemyFolder = enemyFolder:FindFirstChild(enemy)
		local children = specificEnemyFolder:GetChildren()
		local enemyChoice = math.random(1, #children)
		local chosenEnemy = children[enemyChoice]
		if chosenEnemy:HasTag("melee") then
			local enemyInfo = {Parent = game.Workspace.scriptFolders.Enemies,
				SpawnCF = spot.CFrame + Vector3.new(0,1,0),
				WalkSpeed = difficulty["enemySpeed"],
				Health = difficulty["enemyHealth"],
				Model = chosenEnemy,
				EnemyType = enemy,
			}
			local enemyClone = skeleton.new(enemyInfo)
		elseif chosenEnemy:HasTag("BlunderBuss") then
			local enemyInfo = {Parent = game.Workspace.scriptFolders.Enemies,
				SpawnCF = spot.CFrame + Vector3.new(0,1,0),
				WalkSpeed = difficulty["enemySpeed"],
				Health = difficulty["enemyHealth"],
				Model = chosenEnemy,
				EnemyType = enemy,
				CurrentWeapon = "BlunderBuss"}
			local enemyClone = range.new(enemyInfo)
		elseif chosenEnemy:HasTag("Flintlock") then
			local enemyInfo = {Parent = game.Workspace.scriptFolders.Enemies,
				SpawnCF = spot.CFrame + Vector3.new(0,1,0),
				WalkSpeed = difficulty["enemySpeed"],
				Health = difficulty["enemyHealth"],
				Model = chosenEnemy,
				EnemyType = enemy,
				CurrentWeapon = "Flintlock"}
			local enemyClone = range.new(enemyInfo)
		elseif chosenEnemy:HasTag("Musket") then
			local enemyInfo = {Parent = game.Workspace.scriptFolders.Enemies,
				SpawnCF = spot.CFrame + Vector3.new(0,1,0),
				WalkSpeed = difficulty["enemySpeed"],
				Health = difficulty["enemyHealth"],
				Model = chosenEnemy,
				EnemyType = enemy,
				CurrentWeapon = "Musket"}
			local enemyClone = range.new(enemyInfo)
		else
			print("UnknownEnemy")
		end

	end
	
	local itemSpawnSpots = banditCampClone:FindFirstChild("spawnSpots"):FindFirstChild("itemSpawners")
	local itemSpawnSpotsArray = itemSpawnSpots:GetChildren()

	for i = 1, numberOfItems do
		local spot
		local spotChoice
		repeat
			spotChoice = math.random(1, #itemSpawnSpots:GetChildren())
			spot = itemSpawnSpotsArray[spotChoice]
		until spot ~= nil
		itemSpawnSpotsArray[spotChoice] = nil
		local itemPool
		if math.random(1,3) == 1 then
			itemPool = "ValuableResource"
		else
			itemPool = "allValuablePool"
		end
		local item = chooseItem(itemPool)
		local itemClone = game.ServerStorage.spawnableItems:FindFirstChild(item):Clone()
		itemClone.Parent = game.Workspace.scriptFolders.Spawnables
		itemClone:PivotTo(spot.CFrame + Vector3.new(0,2,0))
		spot:Destroy()
	end
	return banditCampClone.PrimaryPart.Position
end

local function spawnRocks(list)
	local Rock = game.ServerStorage.Rock
	local amount = math.random(2,4)
	for i = 1, amount do
		local rockClone = Rock:Clone()
		rockClone.Parent = workspace.scriptFolders.Rocks
		local pos = CFrame.new(math.random(1000, 10000) + meterCount, -13, math.random(-2000, 3000))

		rockClone:PivotTo(pos)
		for island in pairs(list) do
			if (rockClone.Position - list[island]).Magnitude < 600 then
				print("Destroyed")
				rockClone:Destroy()
				break
			end
		end
	end
end

local function spawnEnemies(island, islandName)
	local spawnSpots = island:FindFirstChild("spawnSpots"):FindFirstChild("enemySpawners")
	local maxSpawns = difficulty["maxEnemySpawns"]
	local enemy
	if math.random(1,4) == 1 then
		enemy = "Bandit"
	else
		enemy = islandData.dataForIslands[islandName].enemy
	end
	for i = 1, maxSpawns do
		local spot
		repeat
			local spotChoice = math.random(1, #spawnSpots:GetChildren())
			spot = spawnSpots:FindFirstChild(tostring(spotChoice))
		until spot ~= nil
		
		local specificEnemyFolder = enemyFolder:FindFirstChild(enemy)
		local children = specificEnemyFolder:GetChildren()
		local enemyChoice = math.random(1, #children)
		local chosenEnemy = children[enemyChoice]
		
		
		if chosenEnemy:HasTag("melee") then
			local enemyInfo = {Parent = game.Workspace.scriptFolders.Enemies,
				SpawnCF = spot.CFrame + Vector3.new(0,1,0),
				WalkSpeed = difficulty["enemySpeed"],
				Health = difficulty["enemyHealth"],
				Model = chosenEnemy,
				EnemyType = enemy,
				}
			local enemyClone = skeleton.new(enemyInfo)
		elseif chosenEnemy:HasTag("BlunderBuss") then
			local enemyInfo = {Parent = game.Workspace.scriptFolders.Enemies,
				SpawnCF = spot.CFrame + Vector3.new(0,1,0),
				WalkSpeed = difficulty["enemySpeed"],
				Health = difficulty["enemyHealth"],
				Model = chosenEnemy,
				EnemyType = enemy,
				CurrentWeapon = "BlunderBuss"}
			local enemyClone = range.new(enemyInfo)
		elseif chosenEnemy:HasTag("Flintlock") then
			local enemyInfo = {Parent = game.Workspace.scriptFolders.Enemies,
				SpawnCF = spot.CFrame + Vector3.new(0,1,0),
				WalkSpeed = difficulty["enemySpeed"],
				Health = difficulty["enemyHealth"],
				Model = chosenEnemy,
				EnemyType = enemy,
				CurrentWeapon = "Flintlock"}
			local enemyClone = range.new(enemyInfo)
		elseif chosenEnemy:HasTag("Musket") then
			local enemyInfo = {Parent = game.Workspace.scriptFolders.Enemies,
				SpawnCF = spot.CFrame + Vector3.new(0,1,0),
				WalkSpeed = difficulty["enemySpeed"],
				Health = difficulty["enemyHealth"],
				Model = chosenEnemy,
				EnemyType = enemy,
				CurrentWeapon = "Musket"}
			local enemyClone = range.new(enemyInfo)
		else
			print("UnknownEnemy")
			
		end
		spot:Destroy()
	end
	spawnSpots:Destroy()
end

local function spawnItems(island, islandName)
	local spawnSpots = island:FindFirstChild("spawnSpots"):FindFirstChild("itemSpawners")
	local amountOfItems = math.random(difficulty.minLootSpawn,difficulty.maxLootSpawn)
	for i = 1, amountOfItems do
		local itemSpawnLocation
		repeat
			local itemSpot = math.random(1, #spawnSpots:GetChildren())
			itemSpawnLocation = spawnSpots:FindFirstChild(tostring(itemSpot))
		until itemSpawnLocation ~= nil
		
		local item = chooseItem(islandData.dataForIslands[islandName].LootPool)
		local itemClone = game.ServerStorage.spawnableItems:FindFirstChild(item):Clone()
		itemClone.Parent = island
		itemClone:PivotTo(itemSpawnLocation.CFrame + Vector3.new(0,2,0))
		itemSpawnLocation:Destroy()
	end
	spawnSpots:Destroy()
end

local function spawnIslands(banditCampPos)
	local islandClone
	local isFirstIsland = true
	local totalPosition = 0
	local list = {}
	
	while totalPosition < 8000 do
		local islandChoice = islandList[math.random(1, #islandList)]
		local islandName = islandData.islands[islandChoice]
		local island = islandFolder:FindFirstChild(islandName)
		local islandClone = island:Clone()
		local IslandX = math.random(300,2000)
		islandClone.PrimaryPart.Name = islandName
		islandClone.Parent = workspace.scriptFolders.Islands
		local targetCF = CFrame.new(IslandX + totalPosition + (meterCount), -12, math.random(-200,600))
		islandClone:PivotTo(targetCF)
		while (islandClone.PrimaryPart.Position - banditCampPos).magnitude < 500 do
			local IslandX = math.random(300,2000)
			targetCF = CFrame.new(IslandX + totalPosition + (meterCount), -12, math.random(-200,600))
			islandClone:PivotTo(targetCF)
			print("Moved")
		end
		table.insert(list, islandClone.PrimaryPart.Position)
		islandClone:PivotTo(CFrame.new(islandClone:GetPivot().Position) * CFrame.Angles(0, math.rad(math.random(0, 360)), 0))
		totalPosition += IslandX
		islandClone.PrimaryPart.Name = islandData.dataForIslands[islandName].islandType
		spawnEnemies(islandClone, islandName)
		spawnItems(islandClone, islandName)
		task.wait(2)
	end
	
	spawnRocks(list)

end

local function spawnEverything()
	print("Spawning")
	spawnOutpost()
	local banditCampPos = spawnBanditCamp()
	spawnIslands(banditCampPos)
	meterCount += 10000
end

--Main

for index = 1, #islandData.islands do
	local islandName = islandData.islands[index]
	local weight = islandData.dataForIslands[islandName].weight
	for i = 1, weight do
		table.insert(islandList, index)
	end
end
spawnEverything()

while task.wait(5) do
	for _, player in Players:GetPlayers() do
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			if player.Character.HumanoidRootPart.Position.X > ((meterCount) - 1000) and meterCount < 80000 and cooldown == false then
				cooldown = true
				spawnEverything()
				task.wait(2)
				cooldown = false
			end
		end
	end
end
