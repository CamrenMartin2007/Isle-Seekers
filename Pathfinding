local NpcClass = {}
NpcClass.__index = NpcClass
local updateTime = 0.1
local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local soundModule = require(game.ReplicatedStorage.ModuleScripts.Sound)

function NpcClass.new(args)
	local self = setmetatable({}, NpcClass)
	
	
	self.Model = args.Model:Clone()
	self.Root = self.Model.HumanoidRootPart
	self.Humanoid = self.Model.Humanoid
	self.hasDied = false
	self.Vision = 100
	self.Area = 10
	self.StepDistance = 3
	self.MaxStepHeight = self.Humanoid.JumpPower + 6
	self.LastStepCheck = 0
	self.StepCheckWait = 4
	
	self.WalkAnim = self.Humanoid.WalkAnim
	self.WalkAnimTrack = self.Humanoid:LoadAnimation(self.WalkAnim)
	
	self.RaycastParams = RaycastParams.new()
	self.RaycastParams.FilterType = Enum.RaycastFilterType.Exclude
	self.RaycastParams.FilterDescendantsInstances = {self.Model}
	self.RaycastParams.RespectCanCollide = true
	
	self.pathParams = {
		WaypointSpacing = 1,
		AgentRadius = 1,
		AgentWidth = 1,
		AgentCanJump = true
	}
	
	self.autoJumpDb = tick()
	self.autoJumpConn = self.Root.Touched:Connect(function(hit)
		if hit and hit.CanCollide and hit.Size.Y > 3 then
			self.Humanoid.Jump = true
		end
	end)
	self.Humanoid.StateChanged:Connect(function()
		if self.Humanoid:GetState() == Enum.HumanoidStateType.Swimming then
			self.Humanoid.Jump = true
		end
	end)
	
	self.Humanoid.Died:Connect(function()
		self:Died()
	end)
	
	self.Model.Parent = args.Parent
	self.Root.CFrame = args.SpawnCF
	self.Root:SetNetworkOwner(nil)
	
	self.MainThread = coroutine.create(function()
		
		local ok, errorMsg = xpcall(function()
			
			self:Logic()
			
		end, debug.traceback)
		
		if not ok then
			warn("encountered an error:\n" .. errorMsg)
		end
	end)
	
	
	return self
end

function NpcClass:MoveToWithAnimation(pos)
	self.Humanoid:MoveTo(pos)
	if not self.WalkAnim then return end
	if not self.WalkAnimTrack then return end
	if self.WalkAnimTrack.IsPlaying then return end
	if self.hasDied then return end
	self.WalkAnimTrack:Play()
end

function NpcClass:Logic()
	if self.hasDied then return end
	while true do
		local target = self:FindTarget()

		if target then
			self:Chase(target)

		elseif self.LastTarget
			and self:IsTargetAlive(self.LastTarget)
			and self:DistanceTo(self.LastTarget.HumanoidRootPart.Position) <= self.Vision then

			-- Saw this player before, lost sight, but they are still in range: keep pursuing
			self:Chase(self.LastTarget)
		else
			self.LastTarget = nil
		end
		
		

		task.wait(updateTime)
	end
end

function NpcClass:Chase(target)
	if self.hasDied then return end
	while task.wait(updateTime) do

		if not self:IsTargetAlive(target) then return end

		self.LastTarget = target
		if self:DistanceTo(target.HumanoidRootPart.Position) > self.Vision then
			return
		end

		local seenTarget = self:FindTarget()

		if not seenTarget then

			return self:PathfindTo(target)

		elseif seenTarget ~= target then

			if not self:ShouldPathfind(seenTarget) then
				return self:Chase(seenTarget)
			end

		elseif self:ShouldPathfind(target) then

			return self:PathfindTo(target)

		end


		self:MoveToWithAnimation(target.HumanoidRootPart.Position)
	end
end

function NpcClass:PathfindTo(target, attempts)
	if self.hasDied then return end
	if not self:IsTargetAlive(target) then return end
	if self:DistanceTo(target.HumanoidRootPart.Position) > self.Vision then return end

	local start = self.Root.Position
	local destination = target.HumanoidRootPart.Position

	local path = PathfindingService:CreatePath(self.pathParams)
	path:ComputeAsync(start, destination)

	if path.Status ~= Enum.PathStatus.Success then
		attempts = attempts or 0
		attempts += 1

		if attempts > 3 then 
			return
		end
		task.wait(.5)
		return self:PathfindTo(target, attempts)
	end

	local allWaypoints = path:GetWaypoints()
	if #allWaypoints == 0 then return end
	local lastWaypoint = allWaypoints[#allWaypoints]

	for i, waypoint in ipairs(allWaypoints) do

		-- Abort mid-path if the target died or left our vision range
		if not self:IsTargetAlive(target) then return end
		if self:DistanceTo(target.HumanoidRootPart.Position) > self.Vision then return end

		self:MoveToWithAnimation(waypoint.Position)

		local moved = self.Humanoid.MoveToFinished:Wait()
		if not moved then
			return self:PathfindTo(target)
		end

		local seenTarget = self:FindTarget()
		if not seenTarget then continue end

		local shouldPathfindTo = self:ShouldPathfind(target)

		local targetDistFromEnd = (target.HumanoidRootPart.Position - lastWaypoint.Position).Magnitude

		if not shouldPathfindTo then
			return self:Chase(seenTarget)

		elseif seenTarget == target and targetDistFromEnd > 12 then

			return self:PathfindTo(target)
		end
	end
end

function NpcClass:ShouldPathfind(target)
	if self.hasDied then return end
	local selfDownDirection = Vector3.new(0, -self.MaxStepHeight, 0)
	local selfPos = self.Root.Position
	
	local selfRay = workspace:Raycast(selfPos, selfDownDirection, self.RaycastParams)
	
	local targetParams = RaycastParams.new()
	targetParams.FilterType = Enum.RaycastFilterType.Exclude
	targetParams.FilterDescendantsInstances = {target}
	targetParams.RespectCanCollide = true
	
	local targetMaxDrop = 11
	local targetDownDirection = Vector3.new(0, -targetMaxDrop, 0)
	local targetPos = target.HumanoidRootPart.Position
	
	local targetRay = workspace:Raycast(targetPos, targetDownDirection, targetParams)
	
	if not targetRay or not selfRay then
		return true
	end
	
	local heightDifference = math.abs(targetRay.Position.Y - selfRay.Position.Y)
	if heightDifference > self.Humanoid.JumpHeight then
		return true
	end
	
	local lastStepRaycast = (tick() - self.LastStepCheck)
	if lastStepRaycast < self.StepCheckWait then
		return true
	end
	
	local lookVector = (targetPos - selfPos).Unit
	local stepOrigin = selfPos + lookVector * self.StepDistance
	local stepRay = workspace:Raycast(stepOrigin, selfDownDirection, self.RaycastParams)
	
	if not stepRay then
		self:MoveToWithAnimation(self.Root.Position)
		self.LastStepCheck = tick()
		return true
	end
	
	
end

function NpcClass:FindTarget()
	
	local players = game:GetService("Players"):GetPlayers()
	local inRangeTargets = {}
	
	for i, plr in ipairs(players) do
		local char = plr.Character
		if not char then continue end
		if self:IsTargetAlive(char) == false then continue end
		
		local distToTarget = self:DistanceTo(char.HumanoidRootPart.Position)
		if distToTarget <= self.Vision then
			table.insert(inRangeTargets, {char = char, dist = distToTarget})
		end
		
	end
	
	if #inRangeTargets == 0 then
		return
	end
	
	table.sort(inRangeTargets, function(a,b)
		return a.dist < b.dist
	end)
	
	for i, targetData in pairs(inRangeTargets) do
		if self:CanSee(targetData.char) then
			
			if self:DistanceTo(targetData.char.HumanoidRootPart.Position) < self.Area * .55 then
				
				self:Attack(targetData.char)
			end
			
			return targetData.char
		end
	end
end

function NpcClass:IsTargetAlive(target)
	local result = (target and target:FindFirstChild("HumanoidRootPart") and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0)
	return result
end

function NpcClass:CanSee(target)
	local origin = self.Model.Head.Position
	local direction = (target.HumanoidRootPart.Position - origin).Unit * self.Vision
	local raycast = workspace:Raycast(origin, direction, self.RaycastParams)
	
	if raycast and raycast.Instance.Parent == target then
		
		return true
	end
	return false
end

function NpcClass:DistanceTo(pos)
	return (self.Root.Position - pos).Magnitude
end

function NpcClass:StartAiming(target)
	local lookAt = CFrame.lootAt
	local vector3 = Vector3.new
	local aimPart = target.Humanoid

	self.aimConnection = RunService.Heatbeat:Connect(function()
		local fighterPos = self.Root.Position
		
		if not self:IsTargetAlive(target) then self:StopAim() return end
		
		local lookAtPosition = vector3(aimPart.Position.X, fighterPos.Y, aimPart.Position.Z) + target.Humanoid.MoveDirection*5
		self.Root.CFrame = self.Root.CFrame:Lerp(fighterPos, lookAtPosition, 0.2)
	end)
end



function NpcClass:StopAim()
	if self.aimConnection then
		self.aimConnection:Disconnect()
		self.aimConnection = nil
	end
end


function NpcClass:Died()
	if self.hasDied then return end
	self.hasDied = true
	
	

	self.Humanoid:MoveTo(self.Root.Position)

	if self.WalkAnimTrack then
		self.WalkAnimTrack:Stop()
	end

	self:StopAim()

	if self.autoJumpConn then
		self.autoJumpConn:Disconnect()
		self.autoJumpConn = nil
	end
	
	self.Humanoid.BreakJointsOnDeath = false
	
	for index, joint in ipairs(self.Model:GetDescendants()) do
		if joint:IsA("Motor6D") then
			local socket = Instance.new("BallSocketConstraint")
			local a1 = Instance.new("Attachment")
			local a2 = Instance.new("Attachment")
			a1.Parent = joint.Part0	
			a2.Parent = joint.Part1
			socket.Parent = joint.Parent
			socket.Attachment0 = a1
			socket.Attachment1 = a2
			a1.CFrame = joint.C0
			a2.CFrame = joint.C1
			socket.LimitsEnabled = true
			socket.TwistLimitsEnabled = true
			joint:Destroy()
		end
	end


	soundModule.RangedSound(game.SoundService.EnemyDied, self.Root.Position, 2)

	task.wait(5)
	self.Model:Destroy()
end


function NpcClass:Attack()
	
	warn("Npc tried to attack but no Attack was set")
	
end



return NpcClass

